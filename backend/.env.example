# =============================================================================
# RAKSHA112 Backend Environment Variables
# =============================================================================

# AssemblyAI (Real-time Speech-to-Text WebSocket API)
# Get your API key from https://www.assemblyai.com/dashboard
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Google Maps Platform (Geocoding API for resolving caller location to coordinates in India)
# Get your API key from Google Cloud Console (APIs & Services > Credentials)
MAPS_API_KEY=your_google_maps_api_key_here

# Hugging Face Inference API (Used for ai4bharat/IndicNER entity extraction & mDeBERTa zero-shot emergency classification)
# Get your User Access Token (Read role) from https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_token_here

# Firebase Realtime Database (Optional: override default development project)
# Obtained from Firebase Console (Project Settings > General > Your Apps > SDK setup/configuration)
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_DATABASE_URL=
# FIREBASE_PROJECT_ID=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=

# Recorded Audio Upload Fallback Limits (Optional)
MAX_UPLOAD_AUDIO_MB=15
MAX_UPLOAD_AUDIO_SECONDS=300

# Twilio Telephony Configuration (For live inbound phone calls)
# Obtained from Twilio Console (https://console.twilio.com/)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here
# Optional: Set to 'false' during local dev/testing to bypass signature validation
TWILIO_VALIDATE_SIGNATURE=true

