# =============================================================================
# RAKSHA112 Frontend Environment Variables
# =============================================================================

# Twilio Simulation Demo Line (Configured phone number for callers to dial in the demo)
# Example: +12025550143 or +919876543210
VITE_DEMO_PHONE_NUMBER=+1 (Your Twilio Demo Number)

# Google Maps Platform API Key (Required for Maps JavaScript API & Static Maps)
# Enable: "Maps JavaScript API" and "Maps Static API" in Google Cloud Console
VITE_GOOGLE_API_KEY=your_google_maps_api_key_here

# Firebase Web App Configuration (Optional: override default development project)
# Obtained from Firebase Console (Project Settings > General > Your apps > Web app config)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_DATABASE_URL=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
